---
/**
 * 歌曲表格 — 顯示不重複歌曲列表，可搜尋、展開演唱紀錄。
 * 演唱紀錄は開いたときに /ch/{channelId}.json から描く（[channel].astro の script）。
 */
interface SongStat {
  title: string;
  artist: string;
  count: number;
  appearances: {
    videoId: string;
    date: string;
    videoTitle: string;
    url: string;
  }[];
}

interface Props {
  songs: SongStat[];
  showSearch?: boolean;
}

const { songs, showSearch = true } = Astro.props;

// 最後に歌った日。並べ替えキーと表示の両方に使う
const lastSung = (s: SongStat) =>
  s.appearances.reduce((m, a) => (a.date > m ? a.date : m), "").slice(0, 10);

---

{showSearch && (
  <div class="mb-4">
    <input
      type="search"
      id="song-search"
      placeholder="以曲名或歌手搜尋..."
      data-i18n-placeholder="search.placeholder"
      class="w-full px-4 py-2 border border-border rounded-full text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
    />
    <p id="search-count" class="text-xs text-text-muted mt-1 hidden"></p>
  </div>
)}

<div class="overflow-x-auto">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b-2 border-primary/20 text-left">
        <th class="py-2 px-2 font-medium">
          <!-- 押すと並べ替え。同じ列をもう一度押すと昇順/降順が入れ替わる -->
          <div class="st-grid" id="song-sort">
            <button type="button" data-sort="title" class="sort-btn cursor-pointer text-left hover:text-primary"><span data-i18n="table.song">曲名</span><span class="sort-ind"></span></button>
            <button type="button" data-sort="artist" class="sort-btn cursor-pointer text-left hover:text-primary"><span data-i18n="table.artist">歌手</span><span class="sort-ind"></span></button>
            <button type="button" data-sort="last" class="sort-btn cursor-pointer text-left hover:text-primary text-xs"><span data-i18n="table.last_sung">最後演唱</span><span class="sort-ind"></span></button>
            <button type="button" data-sort="count" class="sort-btn cursor-pointer text-center hover:text-primary text-xs"><span data-i18n="table.count">次數</span><span class="sort-ind"></span></button>
          </div>
        </th>
      </tr>
    </thead>
    <tbody id="song-tbody">
      {songs.map((song) => {
        // 1 チャンネル 1000 行を超えるので、行の中身は短い class にして下の <style> で当てる
        // （Tailwind の class を各行に書くと 1 行 1 KB、1 ページ 1.3 MB になっていた）
        const last = lastSung(song);
        return (
          <tr class="song-row" data-key={`${song.title}\t${song.artist}`} data-last={last} data-count={song.count}>
            <td>
              <details>
                <summary class="st-grid">
                  <span class="st-t"><b>{song.title}</b><button type="button" data-copy={song.title} title="複製 / コピー" class="copy-btn"></button></span>
                  <span class="st-a">{song.artist}</span>
                  <span class="st-d"><span>{last.slice(0, 2)}</span>{last.slice(2)}</span>
                  <span class="st-n">{song.count}</span>
                </summary>
                <div data-apps class="st-apps"></div>
              </details>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>

<script>
  // 並べ替え。初期表示は回数の多い順（getAllSongs / [channel] の並びと同じ）
  const tbody = document.getElementById("song-tbody")!;
  const all = Array.from(tbody.querySelectorAll<HTMLElement>(".song-row"));
  // 曲名・歌手の比較用キーは data-key から作る（行ごとに属性で持つと HTML が膨らむ）
  all.forEach((r) => {
    const [t, a = ""] = r.dataset.key!.split("\t");
    r.dataset.title = t.toLowerCase();
    r.dataset.artist = a.toLowerCase();
  });
  // 初めて押した列の向き。文字列は昇順、日付と回数は「新しい / 多い」順から
  const FIRST_DIR: Record<string, 1 | -1> = { title: 1, artist: 1, last: -1, count: -1 };
  let key = "count", dir: 1 | -1 = -1;
  const coll = new Intl.Collator("ja");

  function cmp(a: HTMLElement, b: HTMLElement): number {
    const A = a.dataset[key] || "", B = b.dataset[key] || "";
    if (key === "count") return (Number(A) - Number(B)) * dir;
    if (!A !== !B) return A ? -1 : 1;          // 空欄（歌手不明など）は向きに関係なく末尾
    return coll.compare(A, B) * dir;
  }
  function apply() {
    // 同順位は元の並び（回数順）を保つ。Array.sort は安定
    tbody.append(...all.slice().sort(cmp));
    document.querySelectorAll<HTMLElement>("#song-sort .sort-btn").forEach((b) => {
      const on = b.dataset.sort === key;
      b.classList.toggle("text-primary", on);
      // 未選択の列にも薄い ↕ を出して、押せる見出しだと分かるようにする
      const ind = b.querySelector<HTMLElement>(".sort-ind")!;
      ind.textContent = on ? (dir > 0 ? " ▲" : " ▼") : " ↕";
      ind.classList.toggle("opacity-30", !on);
    });
  }
  document.getElementById("song-sort")!.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>(".sort-btn");
    if (!b) return;
    const k = b.dataset.sort!;
    if (k === key) dir = dir > 0 ? -1 : 1;
    else { key = k; dir = FIRST_DIR[k]; }
    apply();
  });
  apply();
</script>

{showSearch && (
  <script>
    const input = document.getElementById("song-search") as HTMLInputElement;
    const count = document.getElementById("search-count")!;
    const rows = document.querySelectorAll<HTMLElement>(".song-row");
    let timer: number;

    // Strip zero-width characters (U+200B, U+200C, U+200D, U+FEFF, etc.)
    const stripZW = (s: string) => s.replace(/[\u200B-\u200D\uFEFF\u00AD\u2060\u180E]/g, "");
    // Fold katakana \u2192 hiragana so \u304B\u306A and \u30AB\u30CA match (like case-insensitivity)
    const kana = (s: string) =>
      stripZW(s).replace(/[\u30A1-\u30F6]/g, (c) =>
        String.fromCharCode(c.charCodeAt(0) - 0x60)
      );
    // Drop diacritics so "traumerei" matches "träumerei". Japanese dakuten is
    // U+3099/309A, outside this range, so \u304C stays distinct from \u304B.
    const deaccent = (s: string) => s.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    const norm = (s: string) => deaccent(kana(s));

    input?.addEventListener("input", () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        const q = norm(input.value.toLowerCase().trim());
        let visible = 0;
        rows.forEach((row) => {
          const title = norm(row.dataset.title || "");
          const artist = norm(row.dataset.artist || "");
          const match = !q || title.includes(q) || artist.includes(q);
          row.style.display = match ? "" : "none";
          if (match) visible++;
        });
        if (q) {
          count.textContent = `${visible} / ${rows.length} 曲`;
          count.classList.remove("hidden");
        } else {
          count.classList.add("hidden");
        }
      }, 150);
    });
  </script>
)}

<style is:global>
  /* 見出しと各行で同じ列幅（行は 1 セルの中の grid なので table の列では揃わない）。
     スマホでは曲名が潰れるので、歌手を細くして日付は年の上 2 桁を省く */
  .st-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.5fr) 3.75rem 2.25rem;
    gap: 0.5rem;
    align-items: center;
  }
  @media (min-width: 40rem) {
    .st-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr) 5.5rem 2.5rem; }
  }
  .song-row { border-bottom: 1px solid var(--color-border); }
  .song-row:hover { background: color-mix(in srgb, var(--color-primary) 5%, transparent); }
  .song-row > td { padding: 0.5rem; }
  .song-row summary { cursor: pointer; list-style: none; }
  .song-row summary::-webkit-details-marker { display: none; }
  .st-t { display: flex; align-items: center; gap: 0.25rem; min-width: 0; }
  .st-t b { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .st-a, .st-d { color: var(--color-text-muted); font-size: 0.75rem; }
  .st-a { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .st-d { font-variant-numeric: tabular-nums; }
  .st-d > span { display: none; }
  @media (min-width: 40rem) { .st-d > span { display: inline; } }
  .st-n {
    justify-self: center; display: inline-flex; align-items: center; justify-content: center;
    width: 2rem; height: 1.5rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700;
    color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 10%, transparent);
  }
  .st-apps { margin: 0.5rem 0 0.5rem 1rem; display: grid; gap: 0.25rem; }
</style>
