---
import Base from "../layouts/Base.astro";
import { getAllSongs, getSongMeta } from "../lib/data";

const all = getAllSongs();
const meta = getSongMeta();

const pool = all.map((s) => {
  const m = meta.get(`${s.title}\t${s.artist}`);
  return {
    title: s.title,
    artist: s.artist,
    count: s.count,
    channels: [...new Set(s.appearances.map((a) => a.channelName))],
    tags: m?.tags ?? [],
    dur: m?.durationSec ?? null,
  };
});

const durations = pool.map((s) => s.dur).filter((d): d is number => !!d);
const avgDur = durations.length
  ? Math.round(durations.reduce((a, b) => a + b, 0) / durations.length)
  : 270;

const allTags = [...new Set(pool.flatMap((s) => s.tags))].sort();
const allChannels = [...new Set(pool.flatMap((s) => s.channels))].sort();
const metaFilled = pool.filter((s) => s.tags.length || s.dur).length;
---

<Base title="排歌單" i18nTitleKey="plan.page_title">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-primary mb-1" data-i18n="plan.title">排歌單</h1>
    <p class="text-text-muted text-sm" data-i18n="plan.subtitle">
      篩選、勾選想唱的歌，組成這次歌回的清單。
    </p>
    {metaFilled === 0 && (
      <p class="text-xs mt-2 text-gold" data-i18n="plan.no_meta">
        ⚠ 尚未補完曲目分類/長度，tag 篩選與時間估算暫不可用。
      </p>
    )}
  </div>

  <div class="grid md:grid-cols-[1fr_320px] gap-6 items-start">
    <!-- 左：曲池 -->
    <div>
      <div class="flex flex-wrap gap-2 mb-3">
        <input id="q" type="search" placeholder="搜尋曲名 / 歌手…" data-i18n-placeholder="plan.search"
          class="flex-1 min-w-[180px] px-3 py-2 border border-border rounded-md text-sm" />
        <select id="channel" class="px-3 py-2 border border-border rounded-md text-sm">
          <option value="" data-i18n="plan.all_channels">全部頻道</option>
          {allChannels.map((c) => <option value={c}>{c}</option>)}
        </select>
      </div>

      {allTags.length > 0 && (
        <div id="tagbar" class="flex flex-wrap gap-1.5 mb-3">
          {allTags.map((t) => (
            <button class="tag-chip px-2.5 py-1 rounded-full text-xs border border-border hover:border-primary" data-tag={t} data-i18n={`tag.${t}`}>{t}</button>
          ))}
        </div>
      )}

      <p id="pool-count" class="text-xs text-text-muted mb-2"></p>
      <ul id="pool" class="divide-y divide-border border border-border rounded-md max-h-[62vh] overflow-y-auto"></ul>
    </div>

    <!-- 右：已選清單 -->
    <div class="md:sticky md:top-4 border border-border rounded-md p-3 bg-white">
      <div class="flex items-baseline justify-between mb-2">
        <h2 class="font-bold text-purple" data-i18n="plan.selected">已選</h2>
        <button id="clear" class="text-xs text-text-muted hover:text-primary underline" data-i18n="plan.clear">清空</button>
      </div>
      <div class="text-sm mb-2">
        <span id="sel-count" class="font-bold text-primary">0</span>
        <span data-i18n="plan.songs_unit">首</span>
        <span class="text-text-muted"> · </span>
        <span class="text-text-muted text-xs" data-i18n="plan.est_time">預估時長約</span>
        <span id="sel-time" class="font-bold">0:00</span>
      </div>
      <div class="flex items-center gap-2 mb-3 text-xs text-text-muted">
        <label data-i18n="plan.target">目標</label>
        <input id="target" type="number" min="0" step="10" placeholder="分" class="w-16 px-2 py-1 border border-border rounded" />
        <span data-i18n="plan.minutes">分鐘</span>
        <span id="target-diff"></span>
      </div>
      <button id="autofill" class="w-full mb-2 py-1.5 rounded-full text-xs border border-primary text-primary hover:bg-pink-50"
        data-i18n="plan.autofill">依目標自動組合</button>

      <!-- 排序控制 -->
      <div class="flex flex-wrap items-center gap-2 mb-2 text-xs">
        <label class="flex items-center gap-1 cursor-pointer text-text-muted">
          <input type="checkbox" id="group-artist" />
          <span data-i18n="plan.group_artist">同歌手集中</span>
        </label>
        <select id="sort-by" class="px-2 py-1 border border-border rounded text-xs">
          <option value="manual" data-i18n="plan.sort_manual">手動順序</option>
          <option value="artist" data-i18n="plan.sort_artist">依歌手</option>
          <option value="title" data-i18n="plan.sort_title">依曲名</option>
        </select>
      </div>

      <ol id="selected" class="text-sm space-y-0.5 mb-3 max-h-[40vh] overflow-y-auto"></ol>

      <button id="open-out" class="w-full py-2 rounded-full text-sm text-white bg-primary hover:bg-primary-dark"
        data-i18n="plan.show_list">產生清單</button>
    </div>
  </div>

  <!-- 輸出彈出視窗 -->
  <div id="out-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-lg p-4">
      <div class="flex items-baseline justify-between mb-2">
        <h3 class="font-bold text-purple" data-i18n="plan.list_title">歌單</h3>
        <span id="out-summary" class="text-xs text-text-muted"></span>
      </div>
      <textarea id="out" readonly rows="14"
        class="w-full text-sm border border-border rounded p-2 font-mono bg-gray-50"></textarea>
      <div class="flex gap-2 mt-3">
        <button id="copy" class="flex-1 py-2 rounded-full text-sm text-white bg-primary hover:bg-primary-dark"
          data-i18n="plan.copy">複製清單</button>
        <button id="close-out" class="px-4 py-2 rounded-full text-sm border border-border hover:bg-gray-50"
          data-i18n="plan.close">關閉</button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ pool, avgDur }}>
    var selected = []; // list of pool indices (click order)
    var activeTags = new Set();
    var poolEl = document.getElementById("pool");
    var q = document.getElementById("q");
    var channelSel = document.getElementById("channel");

    function kana(s){ return s.replace(/[ァ-ヶ]/g, function(c){ return String.fromCharCode(c.charCodeAt(0)-0x60); }); }
    function norm(s){ return kana((s||"").toLowerCase()); }
    // 單曲長度: 分:秒 (例 366 -> 6:06)
    function fmtMS(sec){ var m=Math.floor(sec/60), s=sec%60; return m+":"+String(s).padStart(2,"0"); }
    // 清單總長: 時:分 (例 7260 -> 2:01)
    function fmtHM(sec){ var m=Math.round(sec/60), h=Math.floor(m/60); m=m%60; return h+":"+String(m).padStart(2,"0"); }

    function filtered(){
      var text = norm(q.value.trim());
      var ch = channelSel.value;
      return pool.map(function(s,i){ return {s:s,i:i}; }).filter(function(o){
        var s=o.s;
        if (ch && s.channels.indexOf(ch)<0) return false;
        if (activeTags.size){ var hit=false; s.tags.forEach(function(t){ if(activeTags.has(t)) hit=true; }); if(!hit) return false; }
        if (text){ if (norm(s.title).indexOf(text)<0 && norm(s.artist).indexOf(text)<0) return false; }
        return true;
      });
    }

    function renderPool(){
      var rows = filtered();
      document.getElementById("pool-count").textContent = rows.length + " 曲";
      poolEl.innerHTML = "";
      rows.slice(0,600).forEach(function(o){
        var s=o.s, i=o.i, on=selected.indexOf(i)>=0;
        var li=document.createElement("li");
        li.className="flex items-center gap-2 px-3 py-1.5 cursor-pointer hover:bg-pink-50"+(on?" bg-pink-50":"");
        li.innerHTML='<input type="checkbox" '+(on?"checked":"")+' class="pointer-events-none">'+
          '<span class="flex-1 text-sm"><span class="font-medium">'+esc(s.title)+'</span>'+
          (s.artist?' <span class="text-text-muted">/ '+esc(s.artist)+'</span>':'')+
          (s.dur?' <span class="text-xs text-text-muted">('+fmtMS(s.dur)+')</span>':'')+'</span>'+
          (s.tags.length?'<span class="text-[10px] text-purple">'+s.tags.map(function(t){
            return '<span data-i18n="tag.'+esc(t)+'">'+esc(t)+'</span>';
          }).join(" ")+'</span>':'');
        li.onclick=function(){ toggle(i); };
        poolEl.appendChild(li);
      });
      // 動態產生的 tag 節點需重新套翻譯
      if (window.__applyI18n) window.__applyI18n();
    }

    function toggle(i){
      var idx=selected.indexOf(i);
      if (idx>=0) selected.splice(idx,1); else selected.push(i);
      renderPool(); renderSelected();
    }

    /** 依目前排序設定回傳顯示用的順序 (不改動 selected 本身，除了手動搬移)。 */
    function orderedSelection(){
      var mode=document.getElementById("sort-by").value;
      var group=document.getElementById("group-artist").checked;
      var arr=selected.slice();

      if (mode==="artist"){
        arr.sort(function(a,b){
          var c=norm(pool[a].artist).localeCompare(norm(pool[b].artist));
          return c || norm(pool[a].title).localeCompare(norm(pool[b].title));
        });
      } else if (mode==="title"){
        arr.sort(function(a,b){ return norm(pool[a].title).localeCompare(norm(pool[b].title)); });
      } else if (group){
        // 手動順序 + 同歌手集中：保留各歌手首次出現的先後，把同歌手的聚在一起
        var order=[], buckets={};
        arr.forEach(function(i){
          var k=pool[i].artist||"￿";
          if(!buckets[k]){ buckets[k]=[]; order.push(k); }
          buckets[k].push(i);
        });
        arr=[]; order.forEach(function(k){ arr=arr.concat(buckets[k]); });
      }
      return arr;
    }

    function renderSelected(){
      var ol=document.getElementById("selected"); ol.innerHTML="";
      var mode=document.getElementById("sort-by").value;
      var view=orderedSelection();
      var totalSec=0;
      var prevArtist=null;

      view.forEach(function(i, pos){
        var s=pool[i]; totalSec += (s.dur||avgDur);

        // 同歌手集中/依歌手排序時，加上歌手分組標頭
        var grouping=(mode==="artist") || (mode==="manual" && document.getElementById("group-artist").checked);
        if (grouping && s.artist!==prevArtist){
          var h=document.createElement("li");
          h.className="text-[11px] font-bold text-purple pt-1.5 list-none";
          h.textContent=s.artist||"—";
          ol.appendChild(h);
          prevArtist=s.artist;
        }

        var li=document.createElement("li");
        li.className="flex items-center gap-1 group";
        li.innerHTML=
          '<span class="w-5 shrink-0 text-right text-[10px] text-text-muted">'+(pos+1)+'</span>'+
          '<span class="flex-1 leading-tight">'+esc(s.title)+
            (s.artist?' <span class="text-text-muted text-xs">/ '+esc(s.artist)+'</span>':'')+
            (s.dur?' <span class="text-[10px] text-text-muted">('+fmtMS(s.dur)+')</span>':'')+
          '</span>'+
          '<button data-act="up" class="px-0.5 text-text-muted hover:text-primary text-xs disabled:opacity-25" title="上移">▲</button>'+
          '<button data-act="down" class="px-0.5 text-text-muted hover:text-primary text-xs disabled:opacity-25" title="下移">▼</button>'+
          '<button data-act="del" class="px-0.5 text-text-muted hover:text-primary text-xs" title="移除">✕</button>';

        var up=li.querySelector('[data-act="up"]');
        var down=li.querySelector('[data-act="down"]');
        // 只有手動順序才能上下搬移
        if (mode!=="manual"){ up.disabled=true; down.disabled=true; }
        else {
          var realIdx=selected.indexOf(i);
          up.disabled = realIdx<=0;
          down.disabled = realIdx>=selected.length-1;
          up.onclick=function(){ move(realIdx,-1); };
          down.onclick=function(){ move(realIdx,1); };
        }
        li.querySelector('[data-act="del"]').onclick=function(){ toggle(i); };
        ol.appendChild(li);
      });

      document.getElementById("sel-count").textContent=selected.length;
      document.getElementById("sel-time").textContent=fmtHM(totalSec);
      document.getElementById("out").value=view.map(function(i){
        var s=pool[i]; return s.title+(s.artist?" / "+s.artist:"");
      }).join("\n");
      document.getElementById("out-summary").textContent=
        selected.length+" "+txt("plan.songs_unit","首")+" · "+
        txt("plan.est_time","預估時長約")+" "+fmtHM(totalSec);

      // target
      var t=parseInt(document.getElementById("target").value,10);
      var diff=document.getElementById("target-diff");
      if (t>0){ var d=Math.round(totalSec/60)-t; diff.textContent=(d>=0?"+":"")+d+"分"; diff.className=Math.abs(d)<=10?"text-green-600":"text-primary"; }
      else diff.textContent="";
    }

    /** 手動搬移 selected 內的項目 */
    function move(idx, delta){
      var to=idx+delta;
      if (to<0 || to>=selected.length) return;
      var tmp=selected[idx]; selected[idx]=selected[to]; selected[to]=tmp;
      renderSelected();
    }

    function esc(s){ return String(s).replace(/[&<>]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;"}[c];}); }

    /** 取已套用翻譯的文字（從頁面上帶該 data-i18n 的元素讀，語言切換後自動跟著變） */
    function txt(key, fallback){
      var el=document.querySelector('[data-i18n="'+key+'"]');
      return (el && el.textContent.trim()) || fallback;
    }

    q.addEventListener("input", renderPool);
    channelSel.addEventListener("change", renderPool);
    document.getElementById("target").addEventListener("input", renderSelected);
    document.querySelectorAll(".tag-chip").forEach(function(b){
      b.onclick=function(){
        var t=b.dataset.tag;
        if(activeTags.has(t)){ activeTags.delete(t); b.classList.remove("bg-primary","text-white","border-primary"); }
        else { activeTags.add(t); b.classList.add("bg-primary","text-white","border-primary"); }
        renderPool();
      };
    });
    document.getElementById("clear").onclick=function(){ selected=[]; renderPool(); renderSelected(); };

    // 反推模式: 依目標分鐘數 + 目前篩選條件，從曲池隨機組合到接近目標
    document.getElementById("autofill").onclick=function(){
      var t=parseInt(document.getElementById("target").value,10);
      if(!(t>0)){ alert("請先輸入目標分鐘數"); return; }
      var targetSec=t*60;
      // 候選 = 目前篩選結果，排除已選
      var cand=filtered().map(function(o){return o.i;}).filter(function(i){return selected.indexOf(i)<0;});
      // 洗牌 (Fisher-Yates)
      for(var k=cand.length-1;k>0;k--){ var j=Math.floor(Math.random()*(k+1)); var tmp=cand[k]; cand[k]=cand[j]; cand[j]=tmp; }
      var cur=selected.reduce(function(a,i){return a+(pool[i].dur||avgDur);},0);
      for(var n=0;n<cand.length && cur<targetSec;n++){
        var d=pool[cand[n]].dur||avgDur;
        // 加了會超過目標一半以上的歌就跳過，讓總長更貼近目標
        if(cur+d>targetSec+d/2) continue;
        selected.push(cand[n]); cur+=d;
      }
      renderPool(); renderSelected();
    };
    document.getElementById("copy").onclick=function(){
      var out=document.getElementById("out"); out.select(); navigator.clipboard.writeText(out.value);
      var b=document.getElementById("copy"); var o=b.textContent; b.textContent="✓"; setTimeout(function(){ b.textContent=o; },1000);
    };

    // 排序控制
    document.getElementById("group-artist").addEventListener("change", renderSelected);
    document.getElementById("sort-by").addEventListener("change", renderSelected);

    // 輸出彈出視窗
    var outModal=document.getElementById("out-modal");
    function openOut(){ outModal.classList.remove("hidden"); outModal.classList.add("flex"); }
    function closeOut(){ outModal.classList.add("hidden"); outModal.classList.remove("flex"); }
    document.getElementById("open-out").onclick=function(){
      if (!selected.length) return;
      renderSelected(); openOut();
    };
    document.getElementById("close-out").onclick=closeOut;
    outModal.addEventListener("click", function(e){ if (e.target===outModal) closeOut(); });
    document.addEventListener("keydown", function(e){ if (e.key==="Escape") closeOut(); });

    // 切換語言時重繪 (讓動態 tag 跟著換)
    window.addEventListener("langchange", function(){ renderPool(); });

    renderPool(); renderSelected();
  </script>
</Base>
