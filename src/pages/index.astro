---
import Base from "../layouts/Base.astro";
import { getChannels, getStats } from "../lib/data";

const channels = getChannels();
const stats = getStats();
---

<Base title="SEG-V UtaList" description="深淵組 VTuber 歌回曲目索引" i18nTitleKey="index.page_title">
  <section class="text-center mb-12">
    <img src="/seg_nof_logo.png" alt="深淵組非公式" class="h-20 mx-auto mb-4" />
    <h1 class="text-4xl font-bold mb-3 bg-gradient-to-r from-purple to-primary bg-clip-text text-transparent">
      SEG-V UtaList
    </h1>
    <p class="text-text-muted text-lg mb-5" data-i18n="index.subtitle">深淵組成員非公式歌回曲目資料庫</p>

    <button
      id="btn-shuffle-all"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-medium text-white transition-opacity hover:opacity-90 disabled:opacity-60"
      style="background: linear-gradient(135deg, #5e2a89, #e40079);"
      title="Shuffle All"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5" />
      </svg>
      <span data-i18n="index.shuffle_all">全部隨機播放</span>
    </button>
  </section>

  <script is:inline>
    (function () {
      var btn = document.getElementById("btn-shuffle-all");
      if (!btn) return;
      var label = btn.querySelector("span");
      var pool = null;

      btn.addEventListener("click", async function () {
        if (!pool) {
          var original = label.textContent;
          btn.disabled = true;
          label.textContent = "…";
          try {
            var res = await fetch("/shuffle-pool.json");
            pool = await res.json();
          } catch (err) {
            label.textContent = original;
            btn.disabled = false;
            return;
          }
          label.textContent = original;
          btn.disabled = false;
        }
        if (!pool.length) return;

        // Fisher-Yates 洗牌
        var tracks = pool.map(function (r) {
          return { videoId: r[0], start: r[1], title: r[2], artist: r[3], dur: r[4] || null, date: r[5] };
        });
        for (var i = tracks.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var tmp = tracks[i]; tracks[i] = tracks[j]; tracks[j] = tmp;
        }
        if (window.__playQueue) window.__playQueue(tracks, 0);
      });
    })();
  </script>

  {channels.length === 0 ? (
    <p class="text-center text-text-muted" data-i18n="index.no_channels">尚未登錄任何頻道</p>
  ) : (
    <!-- flex + justify-center：チャンネル数が列数に満たなくても中央に揃う -->
    <div class="flex flex-wrap justify-center gap-6">
      {channels.map((ch) => {
        const s = stats[ch.channelId];
        return (
          <a
            href={`/${ch.channelId}`}
            class="block w-full sm:w-[22rem] rounded-lg border border-border bg-white p-6 shadow-sm hover:shadow-md transition-shadow group"
          >
            <div class="flex items-center gap-4 mb-4">
              {ch.avatar && (
                <img
                  src={ch.avatar}
                  alt={ch.name}
                  class="w-14 h-14 rounded-full"
                  loading="lazy"
                />
              )}
              <div>
                <h2 class="font-bold text-lg group-hover:text-primary transition-colors">
                  {ch.name}
                </h2>
              </div>
            </div>
            {s && (
              <div class="grid grid-cols-3 gap-2 text-center text-sm">
                <div>
                  <div class="text-2xl font-bold text-primary">{s.streamCount}</div>
                  <div class="text-text-muted" data-i18n="label.streams">直播</div>
                </div>
                <div>
                  <div class="text-2xl font-bold text-accent">{s.coverCount}</div>
                  <div class="text-text-muted" data-i18n="label.covers">投稿</div>
                </div>
                <div>
                  <div class="text-2xl font-bold text-purple">{s.shortCount}</div>
                  <div class="text-text-muted" data-i18n="label.shorts">Short</div>
                </div>
                <div class="col-span-3 mt-2 pt-2 border-t border-border">
                  <span class="text-text-muted">
                    {s.uniqueSongs} <span data-i18n="label.unique_songs">曲目</span> · {s.totalSongs} <span data-i18n="label.performances">次演唱</span>
                  </span>
                </div>
              </div>
            )}
          </a>
        );
      })}
    </div>
  )}
</Base>
